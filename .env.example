# Copy to .env and fill in. docker compose reads this file automatically.

# --- Proton account -----------------------------------------------------------
# A paid account is required: Proton's server list needs authentication.
PROTON_USERNAME=you@example.com
PROTON_PASSWORD=your-proton-password

# Optional. Set the account's base32 TOTP secret for unattended two-factor
# login. Leave empty to submit codes from the dashboard instead.
PROTON_TOTP_SECRET=

# --- Gluetun ------------------------------------------------------------------
# Your ProtonVPN WireGuard private key, from account.proton.me → Downloads →
# WireGuard configuration.
WIREGUARD_PRIVATE_KEY=

# Which countries the tunnel may use. Codes or names, comma separated.
COUNTRIES=Sweden,Netherlands,Germany

# REQUIRED. Shared secret for Gluetun's control server.
#
# Gluetun's default role does not allow PUT /v1/vpn/settings, which is what this
# tool uses to pin a server, so the role has to be widened. Setting a key rather
# than "auth":"none" keeps the control server closed on the Docker network.
# Any long random string works:
#   openssl rand -hex 32
GLUETUN_API_KEY=change-me

# --- Dashboard ----------------------------------------------------------------
# Uncomment both in docker-compose.yml to enable basic auth.
# DASHBOARD_PASSWORD=

# --- General ------------------------------------------------------------------
TZ=Europe/Stockholm
